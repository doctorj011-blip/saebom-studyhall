rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
//  ⚠️  이 파일이 Firestore 보안 규칙의 "원본"(SINGLE SOURCE OF TRUTH)입니다.
//      2026-07-14 부로 Firebase 콘솔 규칙은 이 파일로 교체되어 관리됩니다.
//
//   · 규칙 변경은 반드시 "이 파일"을 고친 뒤 배포:
//         firebase deploy --only firestore:rules      (또는  scripts/deploy-rules.sh)
//   · Firebase 콘솔에서 직접 수정하지 마세요 — 다음 배포 때 이 파일로 덮어써집니다.
//   · 변경할 때마다 아래 [배포 이력]에 날짜·요약을 남겨 주세요(무엇이 바뀌었는지 추적).
//
//   [배포 이력]
//   - 2026-07-14  통합본을 파일로 이관 + 냉방 컬렉션 3개 추가(ac_config·ac_commands·ac_state)
//   - 2026-07-16  pendingSeats 추가 — 자리변경 예약(학생앱 미래 적용일)이 캐치올에 막혀
//                 permission-denied로 조용히 죽어 있던 것을 수정
//   - 2026-07-17  handover_notes 추가 — 조교 서면 인수인계 메모(관리자앱 📝 인수인계 탭)
//   - 2026-07-23  usage_logs 추가 — 학생앱 사용기록(관리앱 📊 사용기록 탭). create/read/delete만
//                 허용하고 update는 차단(기록 위조 방지)
//   - 2026-07-23  net_daily 추가 — 와이파이 일별 추이. 서버(netDailySnapshot)만 쓰므로
//                 클라이언트는 read 전용
//   - 2026-07-24  standdesk_requests 추가 — 교시 중 스탠드 책상 이동 조교 승인
//                 (학생앱 요청/취소, 관리앱 조교석 승인/거절)
//   - 2026-07-25  seat_presence 추가 — CCTV 좌석 재석 감지(새봄재석감지 엔진이 current
//                 문서 하나를 1분마다 REST로 갱신, 관리앱 대시보드가 읽음)
//   - 2026-07-25  alg_notes 추가 — 대수(응용) 특강 오답노트의 틀린 문항 번호.
//                 문서 ID(로그인 해시)를 아는 사람만 열도록 get 만 열고 list 는 차단
//   - 2026-07-26  alg_notes 의 list 를 원장 계정에만 개방(관리자 모드) + alg_roster 추가
//                 (해시→이름 대조표, 원장만 읽기)
//   - 2026-07-27  shinmungo_reports 추가 — 신문고(학생 기명 신고, delete 금지)
//                 + settings 화이트리스트에 shinmungo_auth(원장 열람 비밀번호)
//   - 2026-07-27  student_memos 추가 — 배치도 특별관리 메모(문서 ID = 학생 이름).
//                 학생앱이 읽는 students 문서와 분리해 둔 것이라 그대로 유지할 것
//   - 2026-07-29  otp_codes 명시 차단 — 새 모바일 앱 OTP 로그인(appauth codebase)의
//                 서버 전용 컬렉션. 캐치올로도 막히지만 사고 방지용으로 명시
//   - 2026-07-29  push_tokens 추가 — 새 모바일 앱 푸시 토큰. 웹앱이 안 쓰는 컬렉션이라
//                 이 저장소에서 유일하게 로그인을 요구한다(본인 uid 것만 쓰기/삭제)
//   - 2026-07-30  geo_notes·geo_roster·geo_teachers 추가 — 고2 기하 오답노트
//                 (saebom-geometry.web.app). 규칙이 빠진 채 앱만 배포돼 캐치올에
//                 전부 막혀 있던 것을 수정. alg_ 와 같은 구조 + 반(sec) 구분:
//                 담당 선생님(geo_teachers/{이메일}의 sec)은 자기 요일 반만 조회
//   - 2026-07-30  zai_notes·zai_roster 추가 — 중2-2 자이스토리 여름특강 오답노트
//                 (saebom-xistory22.web.app). 같은 사고(규칙 누락 403) 수정.
//                 반 구분 없이 alg_ 와 완전히 동일한 원장 단독 구조
// ══════════════════════════════════════════════════════════════════════════

// 새봄 면학관 Firestore 보안 규칙 (2026-07-10 통합본)
// 앱이 쓰는 컬렉션만 허용하고 그 외는 전부 차단합니다.
// ★ 2026-07-10 11:47 게시본에서 빠졌던 세션 엔진(attendance_sessions/current_sessions)과
//   퇴원 보관함(withdrawn_students)을 복원하고, 캐치올 안에 갇혀 있던
//   상담예약(consultations)·학생관리앱(sm_) 규칙을 밖으로 꺼낸 통합본입니다.

service cloud.firestore {
  match /databases/{database}/documents {

    // 학생·스케줄 (관리자앱 저장, 학생앱 자리선택, 학부모앱 조회)
    match /students/{id}       { allow read, write: if true; }
    match /schedules/{id}      { allow read, write: if true; }
    match /schedule_base/{id}  { allow read, write: if true; }
    match /daily_reports/{id}  { allow read, write: if true; }

    // 예약된 자리변경 (학생앱이 미래 적용일에 고른 자리 / 관리자앱이 새벽 2시에 커밋)
    // 문서 ID = 대상 좌석번호. 예약 문서 자체가 좌석 선점 잠금 역할을 한다.
    match /pendingSeats/{seat} { allow read, write: if true; }

    // 입퇴실 기록(감사용): 형식 검증 (type은 in/out만, 이름 30자 이내)
    match /checkin_logs/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.type in ['in', 'out']
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 30
        && request.resource.data.date is string
        && (!('away' in request.resource.data) || request.resource.data.away is bool);
    }

    // ── 시간기록 세션 엔진 (2026-07-10): 입실~퇴실 = 문서 1건 ──
    match /attendance_sessions/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 30
        && request.resource.data.inTs is int
        && request.resource.data.status in ['open', 'closed'];
    }
    // 열린 세션 포인터 (입실 중 = 문서 존재, 퇴실 = 삭제)
    match /current_sessions/{name} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 30
        && request.resource.data.inTs is int;
    }

    // 퇴원생 보관함 (soft delete — 복구/영구삭제/90일 자동정리)
    match /withdrawn_students/{id} { allow read, write: if true; }

    // 스터디룸 신청
    match /studyroom_requests/{id} { allow read, write: if true; }

    // 스탠드 책상 이동 승인: 학생앱이 요청(create)·취소(delete), 관리앱(조교석)이 승인/거절(update).
    // 로그인 없는 정적 앱이라 개방하되 형식만 검증한다(status는 세 값, 이름 30자 이내).
    match /standdesk_requests/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.date is string
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
    }

    // 스케줄 변경 벌점: 학생앱이 기록, 관리자앱이 취소/복구, 세 앱 모두 조회
    match /penalties/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'seatKey', 'date', 'periods'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.seatKey is string
        && request.resource.data.date is string
        && request.resource.data.periods is map;
      allow delete: if false;
    }

    // 상점: 관리자가 수동 부여 (사용시간 탭 상점현황). 벌점과 동일한 개방 정책.
    match /merits/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'seatKey', 'date', 'points'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.seatKey is string
        && request.resource.data.date is string
        && request.resource.data.points is int
        && request.resource.data.points > 0;
      allow delete: if false;
    }

    // 신문고: 학생 기명 신고(학생앱 접수, 관리앱 처리). 신고자는 UI에서 원장 비밀번호로만
    // 열람한다(규칙 수준 차단은 미인증 앱 구조상 불가 — 다른 컬렉션과 같은 개방 정책).
    // 기록 보존을 위해 delete 는 막는다(허위신고 추적·분쟁 대비).
    match /shinmungo_reports/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['reporterName', 'reporterSeatKey', 'category', 'body', 'date', 'status'])
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() <= 30
        && request.resource.data.reporterSeatKey is string
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1200
        && request.resource.data.date is string
        && request.resource.data.status in ['new', 'checking', 'confirmed', 'rejected'];
      allow delete: if false;
    }

    // 좌석 상태: 태블릿 디텍터가 쓰고 대시보드가 읽음
    match /seat_status/{seat} { allow read, write: if true; }

    // CCTV 좌석 재석 감지: 면학관 PC의 새봄재석감지 엔진(로그인 없는 REST)이
    // current 문서 하나만 1분마다 통째로 갱신하고, 관리앱 대시보드가 읽는다.
    // 참고용 신호 데이터라 개방하되 문서 ID와 최소 형식만 제한한다.
    match /seat_presence/{id} {
      allow read: if true;
      allow write: if id == 'current'
        && request.resource.data.updated is string
        && request.resource.data.seats is map;
    }

    // 검수 피드백: 대시보드가 사람 판정 결과 기록
    match /feedback_events/{id} { allow read, write: if true; }

    // SEE EYES 동의: 학생앱이 본인 동의 기록·철회, 대시보드/관리자가 조회
    match /see_eyes_consents/{seat} { allow read, write: if true; }

    // 사용기록: 학생앱이 남기는 앱 사용 로그(로그인·탭 열람 등).
    // 남기기(create)와 조회·정리(read/delete)만 허용하고, 한 번 쓴 기록의 수정(update)은 막는다.
    match /usage_logs/{id} {
      allow read, delete: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.event is string
        && request.resource.data.event.size() <= 40
        && request.resource.data.date is string;
      allow update: if false;
    }

    // 와이파이 일별 추이: netDailySnapshot 함수가 매일 밤 저장한다.
    // 서버(Admin SDK)는 규칙을 우회하므로 클라이언트에는 읽기만 열어 둔다.
    match /net_daily/{date} {
      allow read: if true;
      allow write: if false;
    }

    // 대수(응용) 특강 오답노트(saebom-algebra.web.app): 학생이 틀린 교재 문항 "번호"만 보관한다.
    // 문서 ID = 그 앱의 로그인 해시 PBKDF2(이름+전화뒷4자리) 24자리 — 즉 ID 자체가 열쇠다.
    // 그래서 get 은 열되 list 는 반드시 막아야 한다(열면 ID를 몰라도 전부 훑어진다).
    // 이름·전화번호는 저장하지 않는다(해시→이름 대조표는 로컬 tools/roster.txt 에만 있다).
    // 지우기는 막는다 — 실수나 장난으로 한 학기 기록이 날아가는 편이 훨씬 나쁘다.
    // 관리자 모드는 원장 계정으로 로그인했을 때만. 학생 앱은 로그인이 없으므로
    // 이 조건은 학생 쪽에서는 절대 참이 되지 않는다.
    // ⚠️ email_verified 는 보지 않는다 — 이 프로젝트의 계정은 전부 원장이 직접 만든
    //    password 계정이라 셋 다 emailVerified=false 다. 조건에 넣으면 아무도 못 들어온다.
    //    이미 있는 이메일로는 새 계정을 만들 수 없으니 이메일 일치만으로 충분하다.
    function algTeacher() {
      return request.auth != null
        && request.auth.token.email == 'doctorj011@gmail.com';
    }
    match /alg_notes/{h} {
      allow get: if h.matches('^[0-9a-f]{24}$');
      allow list: if algTeacher();          // 반 전체 조회는 원장만
      allow delete: if false;
      allow create, update: if h.matches('^[0-9a-f]{24}$')
        && request.resource.data.keys().hasOnly(['v', 'exams', 'updatedAt'])
        && request.resource.data.exams is map
        && request.resource.data.exams.size() <= 30
        && request.resource.data.updatedAt is string;
    }
    // 해시 → 이름 대조표. 서버에 이름을 두는 유일한 곳이라 원장만 읽는다.
    // 쓰기는 tools/make_roster.mjs 가 관리자 토큰으로 하므로(규칙 우회) 전부 막는다.
    match /alg_roster/{h} {
      allow read: if algTeacher();
      allow write: if false;
    }

    // 고2 기하 오답노트(saebom-geometry.web.app): alg_notes 와 같은 구조 + 반(sec) 구분.
    // 학생 문서에 sec(수업 요일 반)가 함께 저장되고, 담당 선생님은 geo_teachers/{이메일}
    // 문서의 sec 와 같은 반만 걸러서 조회할 수 있다(앱도 sec 필터를 붙여 묻는다).
    // 원장은 geo_teachers 문서 없이 이메일만으로 전부 본다 — alg_ 와 같은 이유로
    // email_verified 는 보지 않는다(전부 원장이 만든 password 계정).
    function geoDirector() {
      return request.auth != null
        && request.auth.token.email == 'doctorj011@gmail.com';
    }
    function geoTeacherSec() {
      return get(/databases/$(database)/documents/geo_teachers/$(request.auth.token.email)).data.sec;
    }
    match /geo_notes/{h} {
      allow get: if h.matches('^[0-9a-f]{24}$') || geoDirector();
      allow list: if geoDirector()
        || (request.auth != null && resource.data.sec == geoTeacherSec());
      allow delete: if false;
      allow create, update: if h.matches('^[0-9a-f]{24}$')
        && request.resource.data.keys().hasOnly(['v', 'sec', 'exams', 'updatedAt'])
        && request.resource.data.sec is string
        && request.resource.data.sec.size() <= 8
        && request.resource.data.exams is map
        && request.resource.data.exams.size() <= 30
        && request.resource.data.updatedAt is string;
    }
    // 해시 → 이름·반 대조표(name·grade·sec). 원장은 전부, 담당 선생님은 자기 반만.
    // 쓰기는 명단 도구가 관리자 토큰으로 하므로(규칙 우회) 전부 막는다.
    match /geo_roster/{h} {
      allow get, list: if geoDirector()
        || (request.auth != null && resource.data.sec == geoTeacherSec());
      allow write: if false;
    }
    // 선생님 명단(문서 ID = 로그인 이메일, sec = 담당 요일 반). 앱이 로그인 직후
    // 자기 문서 하나를 읽어 담당 반을 알아낸다 — 본인 것만 열고 목록은 막는다.
    // 등록·수정은 Firebase 콘솔에서만.
    match /geo_teachers/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }

    // 중2-2 자이스토리 여름특강 오답노트(saebom-xistory22.web.app):
    // 반 구분 없이 alg_notes·alg_roster 와 완전히 동일한 구조(원장만 전체 조회).
    match /zai_notes/{h} {
      allow get: if h.matches('^[0-9a-f]{24}$');
      allow list: if algTeacher();          // 반 전체 조회는 원장만
      allow delete: if false;
      allow create, update: if h.matches('^[0-9a-f]{24}$')
        && request.resource.data.keys().hasOnly(['v', 'exams', 'updatedAt'])
        && request.resource.data.exams is map
        && request.resource.data.exams.size() <= 30
        && request.resource.data.updatedAt is string;
    }
    match /zai_roster/{h} {
      allow read: if algTeacher();
      allow write: if false;
    }

    // 특별관리 메모(관리앱 배치도): 문서 ID = 학생 이름. 조교가 신경 써야 할 학생을 적어 둔다.
    // students 문서에 필드로 넣지 않은 이유 — 학생앱·학부모앱이 students 를 통째로 읽어 가므로
    // 그 내용이 학생 기기로 그대로 내려간다. 별도 컬렉션이면 그 앱들이 아예 읽지 않는다.
    // 관리가 끝나면 지우는 게 정상이라 delete 는 연다(벌점처럼 남길 기록이 아니다).
    match /student_memos/{name} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.level in ['high', 'mid', 'low']
        && request.resource.data.updatedAt is string;
    }

    // 공지사항: list 문서 하나만 쓰기 허용
    match /notices/{id} {
      allow read: if true;
      allow write: if id == 'list';
    }

    // 조교 인수인계 메모 (문서 ID = {운영일}_{근무조}). 삭제는 막는다 —
    // 인수인계 기록이 사라지면 "안 남겼다/못 봤다"를 확인할 방법이 없어진다.
    match /handover_notes/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['date', 'shift', 'author', 'body'])
        && request.resource.data.date is string
        && request.resource.data.shift in ['morning', 'afternoon', 'night']
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 20
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 3000;
      allow delete: if false;
    }

    // 설정: 앱이 실제로 쓰는 문서만 허용
    // admin_auth = 관리자 기기 등록 마스터 비밀번호(salt+PBKDF2 해시). read는 검증에 필요.
    // vacation_mode = 방학 시간표(평일도 1~11교시). 3개 앱이 read, 관리자앱 설정 탭이 write.
    // meal_away_sms = 점심·저녁 식사시간 외출/복귀 학부모 알림 on/off. 관리자앱만 read/write.
    match /settings/{id} {
      allow read: if true;
      allow write: if id in ['solapi', 'schedule_edit', 'billing', 'admin_auth', 'seatSelection', 'vacation_mode', 'meal_away_sms', 'shinmungo_auth'];
    }

    // 문자 발송 로그
    match /sms_logs/{id} { allow read, write: if true; }

    // 플래너 (사진 메타·선생님 코멘트)
    match /planners/{id}         { allow read, write: if true; }
    match /planner_comments/{id} { allow read, write: if true; }

    // 플래너 AI 검사 — 관리앱이 요청 생성(create만), 결과는 서버(Cloud Function)만 쓴다
    match /planner_ai_requests/{id} { allow read, create: if true; }
    // 결과는 서버가 쓰되, 요약 문장이 틀렸을 때 관리앱에서 고칠 수 있게 summary만 예외로 연다
    // (다시 검사는 API 재호출이라 비용이 든다). quality·stats·comment는 여전히 서버 전용.
    match /planner_ai_reviews/{id}  {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['summary', 'summaryEditedAt'])
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() <= 1000;
      // 검사 수치 교정(statsFixed) — 손글씨 판독이라 교재명 오타·시간 오독이 생기는데,
      // 학습분석이 이 수치로 그려지므로 관리앱에서 사람이 바로잡을 수 있어야 한다.
      // AI 원본(stats)은 그대로 두고 statsFixed만 쓴다 — 분석·다음 검사 이력이 이걸 우선하고,
      // 재검사가 와도 서버가 이 필드를 보존한다. quality·comment·stats는 여전히 서버 전용.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['statsFixed', 'statsFixedAt'])
                    && request.resource.data.statsFixed is map;
    }

    // 자동문 원격 명령: current 문서만, action=open, 30초 이내
    match /door_commands/{id} {
      allow read: if true;
      allow write: if id == 'current'
        && request.resource.data.action == 'open'
        && request.resource.data.seconds is number
        && request.resource.data.seconds <= 30;
    }

    // ── 냉방(에어컨) 제어 — 입퇴실 자동 + 대시보드 수동 제어 ──
    // 로그인 없는 정적 앱이라 기존 컬렉션과 동일하게 개방. LG 통신·PAT는 서버(Cloud Function)만.
    // ac_config: 대시보드가 설정·zone(열람실/스터디룸) 매핑을 읽고 씀
    match /ac_config/{id} { allow read, write: if true; }
    // ac_commands: 대시보드가 수동 명령 생성(전원·온도·모드·풍량·검색). 실행 후 done/error 기록은 서버(Admin SDK)가 규칙 우회.
    match /ac_commands/{id} { allow read, create: if true; }
    // ac_state: 대시보드는 읽기만. 쓰기는 서버(Cloud Function, Admin SDK)만.
    match /ac_state/{id} { allow read: if true; }

    // 상담예약: 예약 등록·조회 허용
    match /consultations/{docId} {
      allow read, create, update, delete: if true;
    }

    // 학생관리앱: sm_ 접두사 컬렉션 (프로토타입 단계: 로그인 필요)
    match /{coll}/{docId} {
      allow read, write: if coll.matches('sm_.*') && request.auth != null;
    }

    // 수납관리: 월별 이용료 납부 기록
    match /payments/{paymentId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasAll(['ym','key','amount'])
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;
    }

    // 인건비 관리 (급여·주민번호): 원장 계정만 접근
    match /pay_employees/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'doctorj011@gmail.com';
    }
    match /pay_months/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'doctorj011@gmail.com';
    }

    // OTP 로그인(새 모바일 앱, functions codebase "appauth"): otp_codes/{전화번호} 에
    // 코드 해시 + 일치 학생(좌석키·이름) 목록이 담긴다. 클라이언트가 읽으면 OTP 가
    // 무력화되고 명부가 새어나가므로 서버(Admin SDK) 전용이다.
    // 캐치올로도 막히지만, 나중에 누가 이 컬렉션을 열려다 사고 나지 않도록 명시해 둔다.
    match /otp_codes/{phone} {
      allow read, write: if false;
    }

    // 푸시 알림 토큰(새 모바일 앱 전용).
    //
    // 이 저장소의 다른 컬렉션과 달리 **처음부터 로그인을 요구한다.** 웹앱 3개는 이
    // 컬렉션을 쓰지 않으므로 조여도 깨질 것이 없기 때문이다. (schedules·penalties 처럼
    // 웹앱과 공유하는 컬렉션은 웹앱이 미인증이라 지금은 조일 수 없다.)
    //
    // 읽기를 아무에게도 열지 않는 이유 — 토큰 목록이 곧 "누가 이 앱을 쓰는가" 명부이고,
    // 토큰을 알면 그 기기로 알림을 보낼 수 있다. 발송은 서버(Admin SDK)가 규칙을
    // 우회해서 하므로 클라이언트 읽기는 필요 없다.
    match /push_tokens/{token} {
      allow read: if false;
      // 자기 계정(uid)의 토큰만 등록·갱신할 수 있다 — 남의 기기에 알림을 꽂지 못하도록.
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['token', 'uid', 'role', 'name', 'seatKey'])
        && request.resource.data.role in ['student', 'parent'];
      // 로그아웃 시 자기 토큰만 지운다.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // 그 외 모든 컬렉션은 읽기·쓰기 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
